auto-install-peers=true
shamefully-hoist=false

# Install scripts are deliberately NOT globally disabled here.
#
# A global "ignore scripts" directive used to live in this file, and it was copied
# verbatim into every generated project — permanently suppressing install scripts for
# the user's own future dependencies and breaking native modules in ways that are hard
# to trace back.
#
# The allowBuilds / onlyBuiltDependencies allowlist in pnpm-workspace.yaml is the right
# mechanism: pnpm blocks postinstall scripts by default and runs them only for the
# packages named there. Same supply-chain protection, without the inherited footgun.
