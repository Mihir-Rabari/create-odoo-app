# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the development environment.
# Local development values are pre-configured for Docker Compose defaults.
# DO NOT commit .env files containing production secrets to version control.
# ==============================================================================

# Application Metadata
APP_NAME=production-starter
NODE_ENV=development
LOG_LEVEL=info

# Service URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=app_db
DATABASE_SSL=false

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage (MinIO / S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=app-uploads
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# Optional Integrations
RESEND_API_KEY=
RESEND_FROM=noreply@example.com

# Authentication & Session Security (Phase 2)
SESSION_SECRET=a_very_secret_32_character_string_for_session_cookies_change_in_prod
SESSION_COOKIE_NAME=app_session
SESSION_TTL_SECONDS=604800

# Root Account Initial Bootstrap (Phase 2)
INITIAL_ROOT_EMAIL=root@example.com
INITIAL_ROOT_PASSWORD=RootSecurePass123!

# Observability (Prometheus & Grafana)
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
MINIO_CONSOLE_PORT=9001
