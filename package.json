{
  "name": "create-odoo-app",
  "version": "1.0.7",
  "description": "Production-grade full-stack application generator with Next.js, Fastify, PostgreSQL, Redis, MinIO, and Identity & IAM system",
  "type": "module",
  "bin": {
    "create-odoo-app": "./dist/cli.js"
  },
  "files": [
    "dist",
    "apps/web/src",
    "apps/web/public",
    "apps/web/package.json",
    "apps/web/next.config.js",
    "apps/web/postcss.config.js",
    "apps/web/tailwind.config.ts",
    "apps/web/tsconfig.json",
    "apps/web/AGENTS.md",
    "apps/api/src",
    "apps/api/package.json",
    "apps/api/tsconfig.json",
    "apps/api/AGENTS.md",
    "packages/auth/src",
    "packages/auth/package.json",
    "packages/auth/tsconfig.json",
    "packages/auth/AGENTS.md",
    "packages/iam/src",
    "packages/iam/package.json",
    "packages/iam/tsconfig.json",
    "packages/iam/AGENTS.md",
    "packages/config/src",
    "packages/config/package.json",
    "packages/config/tsconfig.json",
    "packages/db/src",
    "packages/db/drizzle",
    "packages/db/package.json",
    "packages/db/drizzle.config.ts",
    "packages/db/tsconfig.json",
    "packages/db/AGENTS.md",
    "packages/openapi/src",
    "packages/openapi/package.json",
    "packages/openapi/tsconfig.json",
    "packages/shared/src",
    "packages/shared/package.json",
    "packages/shared/tsconfig.json",
    "packages/validation/src",
    "packages/validation/package.json",
    "packages/validation/tsconfig.json",
    "infrastructure",
    "scripts",
    "skills",
    ".env.example",
    ".gitignore",
    ".npmrc",
    "docker-compose.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "tsconfig.base.json",
    "tsconfig.json",
    "pnpm-workspace.yaml",
    "vitest.config.ts"
  ],
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mihir-Rabari/create-odoo-app.git"
  },
  "author": "Mihir Rabari <https://github.com/Mihir-Rabari>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mihir-Rabari/create-odoo-app/issues"
  },
  "homepage": "https://github.com/Mihir-Rabari/create-odoo-app#readme",
  "scripts": {
    "dev": "pnpm --filter \"@app/*\" --parallel dev",
    "dev:api": "pnpm --filter @app/api dev",
    "dev:web": "pnpm --filter @app/web dev",
    "build": "pnpm --filter \"@packages/*\" build && pnpm --filter \"@app/*\" build && pnpm build:cli",
    "build:cli": "tsc -p tsconfig.cli.json",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --filter \"@packages/*\" build && pnpm --recursive typecheck && tsc -p tsconfig.cli.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:dogfood": "tsx scripts/dogfood-test.ts",
    "test:security": "vitest run packages/auth packages/iam apps/api",
    "audit:security": "tsx scripts/security-audit.ts",
    "deps:check": "tsx scripts/check-deps.ts",
    "skills:check": "tsx scripts/check-skills.ts",
    "skills:lint": "tsx scripts/check-skills.ts --lint",
    "skills:pack": "tsx scripts/pack-skills.ts",
    "skills:export": "tsx scripts/pack-skills.ts --export",
    "skills:list": "tsx scripts/pack-skills.ts --list",
    "skills:show": "tsx scripts/pack-skills.ts --show",
    "verify": "pnpm skills:check && pnpm skills:lint && pnpm lint && pnpm typecheck && pnpm test && pnpm test:smoke && pnpm build",
    "verify:release": "tsx scripts/verify-release.ts",
    "release:check": "tsx scripts/verify-release.ts",
    "release:pack": "pnpm build && npm pack",
    "setup": "tsx scripts/setup.ts",
    "db:generate": "pnpm --filter @packages/db db:generate",
    "db:migrate": "pnpm --filter @packages/db db:migrate",
    "db:seed": "pnpm --filter @packages/db db:seed",
    "db:studio": "pnpm --filter @packages/db db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "health": "tsx scripts/health-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
